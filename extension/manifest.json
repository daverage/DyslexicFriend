{
  "name": "Neuro Friendly",
  "description": "Assistive tools for neurodivergent readers: dyslexia-aware fonts, overlays, focus guides, and sensory supports.",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/contentScript.js"
      ],
      "css": [
        "styles/fonts.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "stopwords-iso.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
