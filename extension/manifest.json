{
  "name": "Dyslexic Friend",
  "description": "Assistive tools for dyslexic readers: apply OpenDyslexic fonts and adjustable color overlays.",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/contentScript.js"
      ],
      "css": [
        "styles/fonts.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
